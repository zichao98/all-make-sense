// Cloudflare Workers：只有靜態檔案（沒有程式碼），內容是 build.mjs 產生的 dist/
{
  "name": "all-make-sense",
  "compatibility_date": "2026-09-01",
  // wrangler deploy / versions upload 會先跑這個指令產生 dist/（Cloudflare Workers Builds 也一樣）
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
